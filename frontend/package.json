{
	"name": "pulsewatch-frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	}
}
