# Copy to .env and adjust as needed. All values below are Session-0 skeleton
# defaults only — no real secrets belong in this file or in .env.

POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch
POSTGRES_DB=pulsewatch

DATABASE_URL=postgres://pulsewatch:pulsewatch@postgres:5432/pulsewatch?sslmode=disable
REDIS_URL=redis://redis:6379/0

PUBLIC_API_URL=http://localhost:8020
