# Copy to .env and adjust as needed. All values below are Session-0 skeleton
# defaults only — no real secrets belong in this file or in .env.

POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch
POSTGRES_DB=pulsewatch

DATABASE_URL=postgres://pulsewatch:pulsewatch@postgres:5432/pulsewatch?sslmode=disable
REDIS_URL=redis://redis:6379/0

# Scheduler (ADR-0001/ADR-0004) — reasoned defaults, adjust per-deployment.
SCHEDULER_WORKER_POOL_SIZE=20
SCHEDULER_TICK_INTERVAL=1s
SCHEDULER_LEASE_SAFETY_MARGIN=5s
SCHEDULER_HARD_SHUTDOWN_DEADLINE=30s

# FR-023: AES-256 key (base64-encoded, must decode to exactly 32 bytes) used
# to decrypt alert_channels.destination_encrypted for dispatch. No real
# channel-registration API exists yet (Session 6), so there is nothing this
# needs to decrypt in a fresh environment — leave unset until one does.
# Generate a real one with: openssl rand -base64 32
ALERT_CHANNEL_ENCRYPTION_KEY=

# Session 8: real operator-session auth (05-api-contracts.md). HMAC signing
# key for the pulsewatch_session cookie — base64-encoded, must decode to at
# least 32 bytes. REQUIRED: the backend refuses to start without it (no
# default value belongs here or anywhere in code — the same discipline this
# project holds itself to against a hardcoded/default operator credential).
# Generate a real one with: openssl rand -base64 32
SESSION_SIGNING_SECRET=

# Read server-side only, by frontend/src/lib/server/backend.ts (never
# exposed to the browser despite the PUBLIC_ prefix SvelteKit's env-module
# split requires — see that file's own comment). Must be the backend's
# address on the Docker Compose network, not a host-facing URL: the browser
# itself never calls this directly (no CORS is enabled on the backend by
# design), only the frontend's own server process does, from inside this
# same Compose network.
PUBLIC_API_URL=http://backend:8080
